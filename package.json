{
  "name": "@lyxx/dsh-session-autotitle",
  "version": "0.2.6",
  "description": "DSH 会话自动命名：全消息 LLM 总结标题（首条提示词/handoff 自动 + 会话头按钮/命令手动），标题调用强制关思考（0.2.0 设置模型下思考接线自补齐），标题语言与最大字节数可设置。适配 DSH ≥ 0.2.0-rc.2（会话格式 v4；更早版本请用 0.2.3）。",
  "scripts": {
    "test": "node --test test/"
  },
  "homepage": "https://github.com/lyxx999/Automatic-session-renaming-for-dsh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyxx999/Automatic-session-renaming-for-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/lyxx999/Automatic-session-renaming-for-dsh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./src/host.mjs",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": "./src/host.mjs",
    "./title": "./src/title.mjs",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session-title": "*",
    "@deepseek-ai/dsh-timeout": "*",
    "@deepseek-ai/dsh-util-values": "*"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "session-title",
    "autotitle"
  ],
  "license": "MIT"
}
